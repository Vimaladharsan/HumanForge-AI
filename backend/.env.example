# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Auth Configuration
JWT_SECRET=change_this_to_a_random_secret

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.md,.rtf,.odt,.java,.py,.js,.ts,.c,.cpp,.cs,.go,.rs,.php,.sql,.html,.css,.json,.xml,.yaml,.yml
